{
  "name": "shiftleft-github-action",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action: run Shift-Left Studio test packs and gate the build on the result",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build src/main.js -o dist --source-map --license licenses.txt",
    "test": "jest",
    "test:regression": "jest --ci",
    "check:dist": "npm run build && git diff --exit-code dist/"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@totalshiftleft/ci": "^1.0.0"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "jest": "^29.7.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ]
  }
}
